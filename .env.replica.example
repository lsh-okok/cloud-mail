# Save as node.env outside source control. Use the one-time node credentials from the primary.
NODE_IMAGE=cloud-mail-app:local
NODE_PRIMARY_URL=https://mail.example.com
NODE_ID=
NODE_CREDENTIAL=
NODE_ALLOW_INSECURE_HTTP=false
NODE_UPSTREAM_TIMEOUT=15000
APP_URL=https://read.example.com
APP_BASE_PATH=
# Generate independently on this node. Never copy the primary keys or administrator password.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=v1
NODE_BIND_ADDRESS=127.0.0.1
NODE_HTTP_PORT=3001
TRUSTED_PROXIES=
TZ=UTC
