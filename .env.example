# Copy to .env; replace every example value before the first start.
COMPOSE_PROJECT_NAME=cloud-mail
APP_URL=https://mail.example.com
# Optional deployment prefix. The proxy must preserve it; rebuild after changing.
APP_BASE_PATH=
# Optional public link base URL (HTTPS, may include the deployment prefix).
PUBLIC_BASE_URL=
# Required for protecting recipient link Tokens and generating links.
# Generate a separate key: openssl rand -hex 32. Keep it with protected recovery material.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=v1
# JSON map of previous key IDs to 64-hex keys, retained during controlled rotation.
DATA_ENCRYPTION_PREVIOUS_KEYS=
# Only these proxy IPs/CIDRs may supply forwarding headers. Empty means no trust.
TRUSTED_PROXIES=
# Only explicit SMTP address exceptions for a controlled internal relay.
# Verification HTTP requests always block private networks; TLS certificates must be valid.
VERIFICATION_SMTP_ALLOW_CIDRS=
MAIL_HOST=mx.example.com
# Comma-separated domains. Each domain receives its own persistent DKIM key.
MAIL_DOMAINS=example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Name of the EXISTING external Docker network used by Nginx Proxy Manager.
NPM_NETWORK=nginx-proxy-manager_default
# Mount the complete NPM /etc/letsencrypt directory, including archive/ and live/.
NPM_CERT_ROOT=/opt/nginx-proxy-manager/letsencrypt
SMTP_TLS_CERT_FILE=/certs/live/npm-1/fullchain.pem
SMTP_TLS_KEY_FILE=/certs/live/npm-1/privkey.pem
SMTP_BIND_ADDRESS=0.0.0.0

# Choose a Docker subnet that does not overlap the host/VPN/existing networks.
MAIL_NETWORK_SUBNET=172.30.89.0/24
DKIM_SELECTOR=mail
MAX_MESSAGE_BYTES=26214400
MAIL_LOG_MAX_BYTES=104857600
MAIL_LOG_KEEP=7
TZ=UTC
